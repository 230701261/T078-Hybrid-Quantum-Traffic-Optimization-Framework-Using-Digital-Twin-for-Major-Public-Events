# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION: QUANTUM TRAFFIC DIGITAL TWIN
# Copy this file to .env and configure your environment-specific settings.
# ==============================================================================

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
DEBUG=false

# Quantum Optimization Service
QUANTUM_SERVICE_URL=http://127.0.0.1:8001
QUANTUM_TIMEOUT_SECONDS=60.0
QUANTUM_DEFAULT_SOLVER=qaoa  # 'qaoa' or 'classical'

# Supabase Cloud Integration (Optional - Falls back to local in-memory store if unset)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Digital Twin Triggers
OPTIMIZATION_TRIGGER_MODE=event_driven  # 'event_driven', 'periodic', or 'manual'
OPTIMIZATION_PERIOD_SECONDS=300
CONGESTION_THRESHOLD_RATIO=0.40
IDEMPOTENCY_CACHE_SIZE=500
